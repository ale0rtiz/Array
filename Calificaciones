#include <stdio.h>

int main()
{   
    float calificaciones[5];
    float promedio=0; 
    int suma=0;
    
    for(int i=0; i<5; i++){
        printf("Ingresa calificaciones: \n");
        scanf("%f", &calificaciones[i]);
        suma=suma+calificaciones[i];
    }
    promedio=suma/5;
    
    printf("El promedio es: %.2f", promedio);
    printf("\n");
    printf("Las calificaciones del alumno son: \n");
    
    for(int i=0; i<5; i++){
        printf("%d: %.2f \n", i, calificaciones[i]);
    }
   if(promedio>=7){
       printf("Aprobo la materia");
   }
   else{
       printf("Reprobo la materia");
   }
    return 0;
}
