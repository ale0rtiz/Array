#include <stdio.h>

int main()
{
    int numeros[8]; 
    
    for(int i=0; i<8; i++){
        printf("Ingrese numero: \n");
        scanf(" %d", &numeros[i]);
    }
    
    for(int i=0; i<8; i++){
        
        if(numeros[i] % 2 == 0){
            printf("%d es par \n", numeros[i]);
        } else{
            printf("%d es impar \n", numeros[i]);
        }
    }
    

    return 0;
}
