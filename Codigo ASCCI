#include <stdio.h>

int main()
{
    char caracteres [10] = {'a', 'b', 'c', 'd', 'e', 'f', 'j', 'h', 'i', 'j'};
    int ascci[10];
    
    
    for(int i=0; i<10; i++){
        printf("%d: %c \n", i + 1, caracteres[i]);
        ascci[i] = (int)caracteres[i];
    }
    
    
    for(int i=0; i<10; i++){
        printf("%c:%d", caracteres[i], ascci[i]);
        printf("\n");
    }
    return 0;
} 
